{
  "name": "vecta-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "vecta": "./bin/vecta.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --alias:react-devtools-core=./src/helpers/react-devtools-core-stub.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/testing/test-oct22-inference-device.ts",
    "test:oct22": "tsx src/testing/test-oct22-inference-device.ts",
    "test:oct21": "tsx src/testing/test-oct21-resilience-ccm.ts",
    "test:queue": "tsx src/testing/test-queue.ts",
    "test:oct20": "tsx src/testing/test-oct20-compaction-pruning.ts",
    "test:oct19": "tsx src/testing/test-oct19-crypto.ts",
    "test:oct18": "tsx src/testing/test-oct18-documenter-handshake.ts",
    "test:memory": "tsx src/testing/test-memory-settings.ts",
    "test:roles": "tsx src/testing/test-roles.ts",
    "test:blank": "tsx src/testing/test-session-blank-chat.ts"
  },
  "dependencies": {
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
